###############################################################################

if {![package vsatisfies [package provide Tcl] 8.4]} then {return}
if {![package vsatisfies [package provide Eagle] 1.0]} then {return}

###############################################################################

package ifneeded Eagle.WatchCat 1.0 \
    [list source -library true -- [file join $dir watchCat.eagle]]

###############################################################################

apply [list [list dir tag] {
  set patchLevel 1.0.9001.43210
  set fileName [file join $dir watchCat.library.eagle]
  set command [list sourceWithInfo]

  if {[info exists ::eagle_platform(patchLevel)] && \
      [package vcompare $::eagle_platform(patchLevel) \
      $patchLevel] > 0} then {
    lappend command -library true
  }

  lappend command -- $fileName
  package ifneeded WatchCat.Library 1.0 $command
}] $dir $tag
